# PayRouters runtime configuration. Copy to .env (or paste into EasyPanel's Environment tab).

# --- Required ---------------------------------------------------------------------------------
# Postgres connection string. Migrations run on start.
DATABASE_URL=postgres://payrouters:CHANGE_ME@db:5432/payrouters
# Public origin of this deployment, no trailing slash. Used for Snap links and provider webhook URLs.
PUBLIC_BASE_URL=https://pay.example.com
# Dashboard login token, at least 16 characters.   openssl rand -hex 24
ADMIN_TOKEN=
# Encrypts provider credentials at rest: base64 of exactly 32 random bytes.   openssl rand -base64 32
# Keep a copy: losing or changing it makes stored provider credentials unreadable.
MASTER_KEY=

# --- Recommended behind a reverse proxy (EasyPanel/Traefik) ------------------------------------
# Header that carries the real client address. Without it every visitor shares the proxy's
# address and one client's failed logins lock everyone out. Only set it when the proxy overwrites it.
TRUSTED_PROXY_HEADER=x-forwarded-for

# --- Optional (defaults shown) -----------------------------------------------------------------
# LISTEN_ADDR=0.0.0.0:8080
# STATS_TIMEZONE=Asia/Jakarta
# LOG_FORMAT=json
# RUST_LOG=info
# RATE_AUTH_FAILS=10
# RATE_API_KEY_FAILS=20
# RATE_AUTH_WINDOW_SECS=300
# RATE_SNAP_PER_MIN=120
# RATE_SNAP_PAY_PER_MIN=20
# RATE_HOOKS_PER_MIN=600
# RATE_GLOBAL_PER_MIN=600
