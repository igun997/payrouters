{
  "name": "@payrouters/sdk",
  "version": "0.1.0",
  "description": "Typed client and webhook verification for the PayRouters product API. Zero runtime dependencies.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/esm/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && printf '{\"type\":\"commonjs\"}\\n' > dist/cjs/package.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "prepublishOnly": "pnpm build && pnpm typecheck && pnpm test"
  },
  "keywords": [
    "payments",
    "payrouters",
    "midtrans",
    "xendit",
    "idrx",
    "webhooks"
  ],
  "devDependencies": {
    "@types/node": "^26.6.10",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
